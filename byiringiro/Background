<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Switch Toggle</title>
    <style>
        body {
            background-color: aqua;
            color: black;
            transition: 0.5s;
        }
    </style>
</head>
<body id="myBody">

    <button onclick="change()">Toggle Mode</button>

    <script>
        // 1. We create a variable to track the "state"
        let mode = "light"; 

        function change() {
            let body = document.getElementById("myBody");

            // 2. The switch checks the current mode
            switch (mode) {
                case "light":
                    body.style.backgroundColor = "#222";
                    body.style.color = "white";
                    mode = "dark"; // Update the variable for next time!
                    break;

                case "dark":
                    body.style.backgroundColor = "aqua";
                    body.style.color = "black";
                    mode = "light"; // Update the variable for next time!
                    break;
            }
        }
    </script>
</body>
</html>
